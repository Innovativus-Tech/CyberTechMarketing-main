# Coverage directory used by testing tools
/coverage

# Misc
.DS_Store
*.pem

# Typescript
*.tsbuildinfo
next-env.d.ts

# Dotenv and similar local-only files
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
